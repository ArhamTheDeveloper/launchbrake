#!/bin/sh
# appblock — block/unblock distracting apps (works for terminal AND launcher)
# Usage:
#   appblock block <app|url> [app...]    add apps/web-app URLs to the blocklist
#   appblock unblock <app|url> [app...]  remove apps from the blocklist
#   appblock toggle <app|url> [app...]   flip blocked state for apps
#   appblock list                    show managed + blocked apps
#   appblock shims                   (re)install PATH shims for managed apps

set -eu

BASE="$HOME/.local/share/appblock"
SHIMS="$BASE/shims"
STATE="$BASE/blocked.list"
MANAGED="$BASE/managed.list"
WEBAPPS="$BASE/webapps.list"
DESKTOP_DIR="$HOME/.local/share/applications"
AUTOSTART_DIR="$HOME/.config/autostart"
BACKUP_DIR="$BASE/autostart-backup"
SELF="$SHIMS/appblock"

# Where a desktop view (GNOME DING, KDE Folder View, xfdesktop, Nemo/Caja,
# pcmanfm-qt) reads launcher files from. Respect XDG user-dirs rather than
# assuming ~/Desktop — omarchy ships XDG_DESKTOP_DIR="$HOME/", i.e. the home
# directory itself. May legitimately not exist (Hyprland has no desktop view).
ICON_DIR=
if command -v xdg-user-dir >/dev/null 2>&1; then
  ICON_DIR=$(xdg-user-dir DESKTOP 2>/dev/null) || ICON_DIR=
fi
if [ -z "$ICON_DIR" ]; then
  udf="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
  if [ -f "$udf" ]; then
    ICON_DIR=$(sed -n 's/^XDG_DESKTOP_DIR="\(.*\)"$/\1/p' "$udf" | head -n1) || ICON_DIR=
    case "$ICON_DIR" in
      *'$HOME'*) ICON_DIR=$HOME${ICON_DIR#*'$HOME'} ;;
    esac
  fi
fi
[ -n "$ICON_DIR" ] || ICON_DIR="$HOME/Desktop"

mkdir -p "$SHIMS" "$DESKTOP_DIR"
touch "$STATE" "$MANAGED" "$WEBAPPS"

is_blocked() { grep -qxF "$1" "$STATE"; }

UNTIL="$BASE/blocked-until.list"   # <canonical-id>|<epoch-seconds>, lazy-expiry timed blocks
touch "$UNTIL"

# FRICTION: lifting a block is deliberately slow. `unblock`/`toggle` never lift
# directly — they only SCHEDULE the lift in unblock-at.list, which reconcile()
# performs once the cooldown elapses. There is intentionally no skip flag; the
# only bypass is editing blocked.list by hand (friction tool, not a security
# tool). Automatic paths — a `--until` deadline passing — are exempt by design.
UNBLOCK_AT="$BASE/unblock-at.list"   # <canonical-id>|<epoch-seconds>, pending lift
touch "$UNBLOCK_AT"
UNBLOCK_WAIT_DEFAULT=600             # 10m default cooldown
UNBLOCK_WAIT_MIN=60                  # floor: `--after 0s` must not be a back door

# parse_duration_to_epoch <spec> — print absolute epoch for a relative duration
# (25m, 2h, 1h30m, 90s) or an absolute time (HH:MM, YYYY-MM-DD HH:MM).
# Uses GNU date -d (Arch/Omarchy); returns non-zero on unparseable input.
parse_duration_to_epoch() {
  spec=$1
  case "$spec" in
    *:*)
      # absolute: append today's date if none given, let date -d normalize
      case "$spec" in
        *-*) ;;                     # already has a date
        *) spec="$(date +%F) $spec" ;;
      esac
      date -d "$spec" +%s 2>/dev/null || return 1
      ;;
    *)
      # relative: split into h/m/s parts (order-independent, composable)
      secs=0; rest=$spec; got=0
      while [ -n "$rest" ]; do
        case "$rest" in
          *h*) num=${rest%%h*}; num=${num##*[!0-9]}; secs=$((secs + ${num:-0}*3600)); rest=${rest#*h} ;;
          *m*) num=${rest%%m*}; num=${num##*[!0-9]}; secs=$((secs + ${num:-0}*60));   rest=${rest#*m} ;;
          *s)  num=${rest%%s*};  num=${num##*[!0-9]}; secs=$((secs + ${num:-0}));      rest=${rest#*s} ;;
          *) return 1 ;;
        esac
        got=1
      done
      [ "$got" -eq 1 ] || return 1
      echo $(( $(date +%s) + secs ))
      ;;
  esac
}

# Timed-block bookkeeping for blocked-until.list  (<id>|<epoch>).
until_add() { [ -n "$2" ] && echo "$1|$2" >>"$UNTIL" || true; }   # (no-op if no epoch)
until_del() {                                                # drop expiry for $1
  [ -s "$UNTIL" ] || return 0
  esc=$(printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g')
  sed -i "/^${esc}|/d" "$UNTIL"
}
# Human-readable remaining time for timed block $1, or empty if none/expired.
until_remaining() {
  ep=$(grep "^$1|" "$UNTIL" 2>/dev/null | tail -n1 | cut -d'|' -f2) || ep=
  [ -n "$ep" ] || return 0
  now=$(date +%s); left=$((ep - now))
  [ "$left" -le 0 ] && return 0
  if   [ "$left" -ge 3600 ]; then printf '%dh%dm left' $((left/3600)) $((left%3600/60))
  elif [ "$left" -ge 60 ];   then printf '%dm left' $((left/60))
  else printf '%ds left' "$left"; fi
}

# --- friction bookkeeping for unblock-at.list (<id>|<epoch>) ------------------
# Schedule (or re-schedule) the pending lift of $1 $2 seconds from now.
unblock_add() {
  [ -n "${2:-}" ] || return 0
  esc=$(printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g')
  [ -s "$UNBLOCK_AT" ] && sed -i "/^${esc}|/d" "$UNBLOCK_AT"
  printf '%s|%s\n' "$1" "$(( $(date +%s) + $2 ))" >>"$UNBLOCK_AT"
}
# Forget a pending lift (the block itself stays).
unblock_del() {
  [ -s "$UNBLOCK_AT" ] || return 0
  esc=$(printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g')
  sed -i "/^${esc}|/d" "$UNBLOCK_AT"
}
unblock_pending() { grep -q "^$1|" "$UNBLOCK_AT" 2>/dev/null; }
# Human-readable cooldown left for $1, or empty if none/elapsed.
unblock_remaining() {
  ep=$(grep "^$1|" "$UNBLOCK_AT" 2>/dev/null | tail -n1 | cut -d'|' -f2) || ep=
  [ -n "$ep" ] || return 0
  now=$(date +%s); left=$((ep - now))
  [ "$left" -le 0 ] && return 0
  if   [ "$left" -ge 3600 ]; then printf '%dh%dm' $((left/3600)) $((left%3600/60))
  elif [ "$left" -ge 60 ];   then printf '%dm' $((left/60))
  else printf '%ds' "$left"; fi
}
# Announce a scheduled (NOT lifted) unblock for canonical key $1.
unblock_notice() {
  _rem=$(unblock_remaining "$1")
  echo "⏳ $1 stays blocked for another ${_rem:-moment} — lifts on the next run or launch after that"
  echo "   longer: appblock unblock $1 --after 30m   ·   forget it: appblock unblock $1 --cancel"
}

# Find the real binary for NAME, searching PATH while skipping the shim dir.
find_real() {
  name=$1; found=
  oIFS=$IFS; IFS=:; set -f; set -- $PATH; IFS=$oIFS; set +f
  for d in "$@"; do
    [ "$d" = "$SHIMS" ] && continue
    [ -n "$d" ] && [ -x "$d/$name" ] && { found="$d/$name"; break; }
  done
  echo "$found"
}

# Create/refresh the PATH shim for an app so 'app <args>' resolves to it.
install_shim() {
  name="$1"                 # launch/PATH name: shim filename, exec target, MANAGED
  key="${2:-}"              # blocklist key: the resolved canonical desktop id
  # Resolve the canonical key here when the caller has none (the `shims` refresh
  # loop only knows MANAGED launch names). Same-name apps collapse to the old
  # behaviour; reverse-DNS ids (Flatpak-style: org.mozilla.firefox) get a shim
  # that actually matches blocked.list.
  [ -n "$key" ] || key=$(resolve_desktop_id "$name" 2>/dev/null) || key=
  [ -n "$key" ] || key="$name"
  # STRUCTURAL GUARD (not just convention): generated shims live under
  # $SHIMS. If one is ever (accidentally, via refactor) made to re-invoke
  # appblock, refuse rather than risk touching state/cleanup from launch
  # context — e.g. a transient PATH gap must never delete a shim at run time.
  # Compare the SYMLINK-RESOLVED path: the legit `appblock` command reaches
  # us via the shims/appblock symlink, so "$0" alone would false-positive.
  self0=$(readlink -f "$0" 2>/dev/null || echo "$0")
  case "$self0" in
    "$SHIMS"/*) echo "  ! appblock may not run from within a shim (launch-time is never a management moment)" >&2; return 1 ;;
  esac
  [ "$name" = "appblock" ] && return 1
  real=$(find_real "$name")
  if [ -z "$real" ] && [ -f "$SHIMS/$name" ]; then
    # PATH no longer resolves the app directly (e.g. binary moved after an
    # upgrade); fall back to the path the existing shim was created with.
    real=$(sed -n 's/^exec "\([^"]*\)" .*/\1/p' "$SHIMS/$name")
  fi
  [ -n "$real" ] && [ -x "$real" ] || {
    # Nothing valid to exec — don't leave a shim that would look like a
    # broken app later. Removing it means 'app' → honest "command not found".
    # Silent on purpose: caller (block loop / `shims` refresh) owns messaging,
    # so shim-less apps like web-apps resolved via desktop entry don't get
    # spammed with PATH warnings.
    # NOTE: this runs ONLY during explicit CLI invocations (block/unblock/
    # toggle/shims); generated shims never call install_shim, so a transient
    # PATH gap during a package upgrade can never delete a shim at launch time.
    rm -f "$SHIMS/$name"
    return 1
  }
  grep -qxF "$name" "$MANAGED" || echo "$name" >>"$MANAGED"
  cat >"$SHIMS/$name.tmp" <<EOF
#!/bin/sh
# generated by appblock — do not edit (refresh with: appblock shims)
# appblock-block-key: $key
# NAMED for the launch binary ($name) but KEYED on the canonical id above —
# they differ for reverse-DNS desktop ids (e.g. org.mozilla.firefox).
if grep -qxF '$key' "$STATE" 2>/dev/null; then
  # Lazy expiry, both kinds, checked AT LAUNCH so nothing runs in the background:
  #   - a --until deadline that has passed
  #   - a friction cooldown ('appblock unblock') whose wait has elapsed
  now=\$(date +%s)
  ep=\$(grep -F '$key|' "$UNTIL" 2>/dev/null | tail -n1 | cut -d'|' -f2) || ep=
  up=\$(grep -F '$key|' "$UNBLOCK_AT" 2>/dev/null | tail -n1 | cut -d'|' -f2) || up=
  reason=
  if [ -n "\$ep" ] && [ "\$now" -ge "\$ep" ]; then reason="timed block expired"
  elif [ -n "\$up" ] && [ "\$now" -ge "\$up" ]; then reason="cooldown elapsed"
  fi
  if [ -n "\$reason" ]; then
    # NOTE: grep -v exits 1 when it filters out EVERY line, so chaining mv with
    # && would skip the rename exactly when the last block is lifted. Write the
    # filtered file first, then always move it into place.
    grep -vxF '$key' "$STATE" > "$STATE.tmp" || :
    mv -f "$STATE.tmp" "$STATE"
    grep -vF '$key|' "$UNTIL" 2>/dev/null > "$UNTIL.tmp" || :
    mv -f "$UNTIL.tmp" "$UNTIL"
    grep -vF '$key|' "$UNBLOCK_AT" 2>/dev/null > "$UNBLOCK_AT.tmp" || :
    mv -f "$UNBLOCK_AT.tmp" "$UNBLOCK_AT"
    echo "⏳ $name \$reason, unblocking" >&2
  else
    echo "🚫 $name is blocked (unblock with: appblock unblock $name)" >&2
    exit 1
  fi
fi
exec "$real" "\$@"
EOF
  mv -f "$SHIMS/$name.tmp" "$SHIMS/$name"
  chmod +x "$SHIMS/$name"
}

# --- canonical-key -> shim lookup --------------------------------------------
# Shims are NAMED after the launch binary but key off the canonical desktop id
# (see install_shim), so callers holding only the id (list, reconcile) need a
# way back. The marker line embedded in every generated shim is authoritative:
# it is emitted from the same variable as the blocklist check, so a shim that
# carries the marker provably compares against exactly that key.
shim_for_key() {
  [ -n "${1:-}" ] || return 1
  [ -f "$SHIMS/$1" ] && { printf '%s\n' "$SHIMS/$1"; return 0; }   # fast path
  for _sf in "$SHIMS"/*; do
    [ -f "$_sf" ] || continue
    grep -qxF "# appblock-block-key: $1" "$_sf" 2>/dev/null && { printf '%s\n' "$_sf"; return 0; }
  done
  return 1
}
# Launch-binary name behind canonical key $1 (empty when no shim exists).
shim_binary_for_key() { _sbk=$(shim_for_key "$1") && printf '%s\n' "${_sbk##*/}"; }

# Directories GLib/menus search for .desktop entries, in override precedence
# order. $DESKTOP_DIR (user data) is last as a SOURCE — but first as an
# override location — and is also where Chromium PWAs / omarchy web-app
# install their real entry, which is why user-dir sources get the rename
# flow below instead of an override (an override would clobber the original).
ALL_DIRS="/usr/share/applications /usr/local/share/applications \
/var/lib/flatpak/exports/share/applications \
\"$HOME/.local/share/flatpak/exports/share/applications\" \
\"$DESKTOP_DIR\""

# Print the absolute path of the canonical <id>.desktop if it exists.
find_desktop_file() {
  name=$1
  eval "set -- $ALL_DIRS"
  for d in "$@"; do
    [ -f "$d/$name.desktop" ] && { echo "$d/$name.desktop"; return 0; }
  done
  return 1
}

# Resolve a user-typed name to a canonical desktop-id (basename, no suffix).
# Direct hit first; otherwise fuzzy-match Name= / URL in user data dirs
# (where web-apps/PWAs live), then the rest. Also matches entries currently
# renamed aside by us (.appblock-disabled.<id>.desktop.off) so unblock works
# while blocked. Prints the id; exits 1 if unresolvable or ambiguous (>1 match).
resolve_desktop_id() {
  name=$1
  find_desktop_file "$name" >/dev/null 2>&1 && { echo "$name"; return 0; }
  lowname=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
  found=; count=0
  for d in "$DESKTOP_DIR" \
           "$HOME/.local/share/flatpak/exports/share/applications" \
           /usr/share/applications /usr/local/share/applications \
           /var/lib/flatpak/exports/share/applications; do
    [ -d "$d" ] || continue
    for f in "$d"/*.desktop "$d"/.appblock-disabled.*.desktop.off; do
      [ -f "$f" ] || continue
      base=$(basename "$f" .off)
      base=${base#.appblock-disabled.}   # strip our rename prefix
      base=${base%.desktop}              # then the .desktop suffix
      lbase=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
      [ "$lbase" = "$lowname" ] && { found=$base; count=$((count+1)); continue; }
      n=$(sed -n 's/^Name=//p' "$f" | head -n1 | tr '[:upper:]' '[:lower:]')
      [ "$n" = "$lowname" ] && { found=$base; count=$((count+1)); continue; }
      # URL match: name appears in any https:// host or path in the file
      url=$(grep -o 'https\?://[^/)"[:space:]]*' "$f" | head -n1 | tr '[:upper:]' '[:lower:]')
      case "$url" in
        *"$lowname"*) found=$base; count=$((count+1)) ;;
      esac
    done
    # only fall through to system dirs if user dirs found nothing
    [ "$count" -gt 0 ] && break
  done
  [ "$count" -eq 1 ] && { echo "$found"; return 0; }
  if [ "$count" -gt 1 ]; then
    echo "     ! '$name' is ambiguous — matches multiple desktop entries; use the exact id" >&2
  fi
  return 1
}

# Hide the app's .desktop entry from app menus.
#   system/flatpak dir source → NoDisplay override (Base Directory Spec:
#   $XDG_DATA_HOME always wins — verified against GLib GAppInfo).
#   user-data-dir source (PWA/web-app original lives where we'd write) →
#   rename out of the way; GLib ignores non-.desktop names, byte-preserving
#   and reversible. GNOME Shell caches its grid; may need logout to refresh.
hide_desktop() {
  id=$1
  src=$(find_desktop_file "$id") || return 0
  case "$src" in
    "$DESKTOP_DIR"/*)
      mv -f "$src" "$DESKTOP_DIR/.appblock-disabled.$id.desktop.off" 2>/dev/null \
        && echo "  → hid desktop entry: $id (web-app/PWA, reversible)"
      ;;
    *)
      printf '[Desktop Entry]\n# appblock override — do not edit\nType=Application\nName=%s\nNoDisplay=true\nExec=%s\n' "$id" "$id" \
        >"$DESKTOP_DIR/$id.desktop"
      ;;
  esac
}

unhide_desktop() {
  # Remove ONLY the NoDisplay override WE wrote (marker-checked). In the
  # user-data-dir flow the live .desktop is the user's own file (web-app/PWA
  # entry), renamed aside rather than overridden — deleting it here destroyed it
  # on a second unblock, or after a timed expiry had already restored it.
  if [ -f "$DESKTOP_DIR/$1.desktop" ] \
     && grep -q '^# appblock override' "$DESKTOP_DIR/$1.desktop" 2>/dev/null; then
    rm -f "$DESKTOP_DIR/$1.desktop"
  fi
  if [ -f "$DESKTOP_DIR/.appblock-disabled.$1.desktop.off" ]; then
    mv -f "$DESKTOP_DIR/.appblock-disabled.$1.desktop.off" "$DESKTOP_DIR/$1.desktop" \
      && echo "  → restored desktop entry: $1"
  fi
  return 0
}

# True if a menu would currently show $1 — i.e. a live desktop entry that is
# NOT masked by our NoDisplay override and not renamed aside (web-app/PWA).
desktop_visible() {
  src=$(find_desktop_file "$1") || return 1
  case "$src" in
    "$DESKTOP_DIR"/*) grep -q '^NoDisplay=true' "$src" && return 1 ;;
  esac
  [ -f "$DESKTOP_DIR/$1.desktop" ] && grep -q '^NoDisplay=true' "$DESKTOP_DIR/$1.desktop" 2>/dev/null && return 1
  return 0
}

# --- web-app URL guard -------------------------------------------------------
# omarchy web-app keybinds (e.g. SUPER SHIFT X) never touch a .desktop entry:
# Hyprland runs `omarchy-launch-webapp <url>`, which resolves the browser
# binary itself. Menu hiding therefore cannot stop them. The one hook on that
# path is PATH — `omarchy-launch-webapp` is resolved by the shell (also via
# `omarchy-launch-or-focus-webapp`, which does `eval exec setsid $CMDLINE`),
# and our shims dir is prepended to it. While any URL is blocked we own that
# name; with nothing blocked the shim is absent, so the real launcher runs
# untouched and there is no permanent indirection.

WEBGUARD_NAME=omarchy-launch-webapp

# Canonical form for URL comparison: no scheme, no trailing slashes, lowercase.
normalize_url() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's#^https\?://##; s#/*$##'
}

# Desktop file for $1, live or renamed aside by us.
find_desktop_any() {
  find_desktop_file "$1" && return 0
  f="$DESKTOP_DIR/.appblock-disabled.$1.desktop.off"
  [ -f "$f" ] && { echo "$f"; return 0; }
  return 1
}

# The URL a web-app entry launches (Exec line only), if any.
webapp_url() {
  p=$(find_desktop_any "$1") || return 1
  sed -n 's/^Exec=//p' "$p" | head -n1 | grep -o 'https\?://[^ "]*' | head -n1
}

# Record/forget a blocked web-app as "<id>|<normalized-url>".
webapp_add() {
  [ -n "${2:-}" ] || return 0
  grep -qxF "$1|$2" "$WEBAPPS" 2>/dev/null || printf '%s|%s\n' "$1" "$2" >>"$WEBAPPS"
}
webapp_del() {
  sed -i "/^$(printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g')|/d" "$WEBAPPS"
}

# Is $1's URL currently covered by a live guard shim? (drives `list` labels)
webguarded() {
  [ -f "$SHIMS/$WEBGUARD_NAME" ] || return 1
  u=$(webapp_url "$1" 2>/dev/null) || return 1
  [ -n "$u" ] || return 1
  grep -qF "|$(normalize_url "$u")" "$WEBAPPS" 2>/dev/null
}

webguard_write() {
  real=$(find_real "$WEBGUARD_NAME")
  [ -n "$real" ] && [ -x "$real" ] || return 1
  cat >"$SHIMS/$WEBGUARD_NAME.tmp" <<EOF
#!/bin/sh
# generated by appblock — web-app URL guard (do not edit)
# Owns this name only while a web-app URL is blocked; falls through to the
# real launcher for everything else.
url=
for a in "\$@"; do
  case "\$a" in
    http://*|https://*) url="\$a"; break ;;
  esac
done
if [ -n "\$url" ]; then
  norm=\$(printf '%s' "\$url" | tr '[:upper:]' '[:lower:]' | sed 's#^https\?://##; s#/*\$##')
  while IFS='|' read -r id blk; do
    [ -n "\$blk" ] || continue
    case "\$norm" in
      "\$blk"|"\$blk"/*)
        echo "🚫 \$id is blocked (unblock with: appblock unblock \$id)" >&2
        exit 1 ;;
    esac
  done <"$WEBAPPS"
fi
exec "$real" "\$@"
EOF
  mv -f "$SHIMS/$WEBGUARD_NAME.tmp" "$SHIMS/$WEBGUARD_NAME"
  chmod +x "$SHIMS/$WEBGUARD_NAME"
}

remove_webguard() {
  f="$SHIMS/$WEBGUARD_NAME"
  [ -f "$f" ] || return 0
  grep -q 'generated by appblock — web-app URL guard' "$f" 2>/dev/null || return 0
  rm -f "$f"
}

# Keep the guard in sync with the blocklist. Runs on every block/unblock/
# shims/list so a deleted or stale guard self-heals; the shim disappears the
# moment the last URL block is lifted.
refresh_webguard() {
  if [ -s "$WEBAPPS" ]; then
    webguard_write && return 0
    echo "  ! '$WEBGUARD_NAME' not found on PATH — web-app keybind interception unavailable" >&2
    return 1
  fi
  remove_webguard
}

# --- desktop icons (a namespace of their own) --------------------------------
# A desktop view shows *files*, and double-clicking one launches its Exec by
# path — so NoDisplay/Hidden (menu-listing keys) are irrelevant, and an
# absolute Exec bypasses PATH too. Same reversible rename trick as user-dir
# web-apps, matched by what the launcher file actually points at:
# its Exec basename, or the web-app URL it opens.

# url_covered <url> <blocked-url> — blocked URL and everything under it.
url_covered() {
  n=$(normalize_url "$1"); b=$(normalize_url "$2")
  [ "$n" = "$b" ] && return 0
  case "$n" in "$b"/*) return 0 ;; esac
  return 1
}

# Does launcher file $1 point at blocked id $2?
icon_matches() {
  ex=$(sed -n 's/^Exec=//p' "$1" | head -n1)
  # Launcher names this icon may point at: the canonical id we were handed, plus
  # the launch binary behind it (they differ for reverse-DNS desktop ids).
  _im_alt=$(shim_binary_for_key "$2") || _im_alt=
  # Scan every token, not just the first: wrappers are the norm (e.g. Wine/game
  # icons are `Exec=env "WINEPREFIX=…" wine "…lnk"`, whose first token is `env`).
  for tok in $ex; do
    tok=${tok#\"}; tok=${tok%\"}; tok=${tok#\'}; tok=${tok%\'}
    _im_bn=${tok##*/}
    [ "$_im_bn" = "$2" ] && return 0
    [ -n "$_im_alt" ] && [ "$_im_bn" = "$_im_alt" ] && return 0
  done
  u=$(printf '%s' "$ex" | grep -o 'https\?://[^ "]*' | head -n1) || u=
  [ -n "$u" ] || return 1
  case "$2" in
    http://*|https://*) url_covered "$u" "$2" && return 0 ;;
  esac
  w=$(webapp_url "$2" 2>/dev/null) || w=
  [ -n "$w" ] && url_covered "$u" "$w" && return 0
  return 1
}

hide_desktop_icons() {
  [ -n "$ICON_DIR" ] && [ -d "$ICON_DIR" ] || return 0
  for f in "$ICON_DIR"/*.desktop; do
    [ -f "$f" ] || continue
    icon_matches "$f" "$1" || continue
    b=$(basename "$f")
    mv -f "$f" "$ICON_DIR/.appblock-disabled.$b.off" 2>/dev/null \
      && echo "  → hid desktop icon: $b"
  done
  return 0
}

restore_desktop_icons() {
  [ -n "$ICON_DIR" ] && [ -d "$ICON_DIR" ] || return 0
  for f in "$ICON_DIR"/.appblock-disabled.*.desktop.off; do
    [ -f "$f" ] || continue
    icon_matches "$f" "$1" || continue
    b=$(basename "$f"); b=${b#.appblock-disabled.}; b=${b%.off}
    mv -f "$f" "$ICON_DIR/$b" 2>/dev/null && echo "  → restored desktop icon: $b"
  done
  return 0
}

# XDG autostart entries (tray/background apps) often use absolute Exec paths
# and bypass PATH entirely. Disable on block, restore on unblock.
disable_autostart() {
  [ -d "$AUTOSTART_DIR" ] || return 0
  for f in "$AUTOSTART_DIR"/*.desktop; do
    [ -f "$f" ] || return 0
    ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
    [ "${ex##*/}" = "$1" ] || continue
    mkdir -p "$BACKUP_DIR"
    cp -n "$f" "$BACKUP_DIR/"
    grep -q '^Hidden=' "$f" && sed -i 's/^Hidden=.*/Hidden=true/' "$f" \
      || printf 'Hidden=true\n' >>"$f"
    echo "  → disabled autostart entry: $(basename "$f")"
  done
}

# Re-enable an autostart entry at unblock, MERGING rather than restoring:
# only ever touch the Hidden key we may have patched, and leave every other
# line (Exec, flags, etc.) exactly as the live file has it — an app update
# that legitimately changed Exec= between block and unblock must NOT be
# reverted by us. The backup exists solely to recover the original Hidden value.
restore_autostart() {
  [ -d "$AUTOSTART_DIR" ] || return 0
  for f in "$AUTOSTART_DIR"/*.desktop; do
    [ -f "$f" ] || continue
    ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
    [ "${ex##*/}" = "$1" ] || continue
    orig=
    b="$BACKUP_DIR/$(basename "$f")"
    [ -f "$b" ] && orig=$(sed -n 's/^Hidden=//p' "$b" | head -n1)
    # drop our patch, then re-apply the file's original Hidden value if any
    sed -i '/^Hidden=/d' "$f"
    [ -n "$orig" ] && printf 'Hidden=%s\n' "$orig" >>"$f"
    rm -f "$b"
    echo "  → re-enabled autostart entry: $(basename "$f")"
  done
}

# True if a menu would currently show $1 — i.e. a live desktop entry that is
# NOT masked by our NoDisplay override (system source) and not renamed aside
# (user-dir web-app/PWA source).
desktop_visible() {
  src=$(find_desktop_file "$1") || return 1
  case "$src" in
    "$DESKTOP_DIR"/*) grep -q '^NoDisplay=true' "$src" && return 1 ;;
  esac
  [ -f "$DESKTOP_DIR/$1.desktop" ] && grep -q '^NoDisplay=true' "$DESKTOP_DIR/$1.desktop" 2>/dev/null && return 1
  return 0
}

# Re-apply hiding for everything still in the blocklist. Repairs drift:
# an app update can silently overwrite our autostart Hidden=true (some apps
# re-add their own autostart entry), or a PWA/web-app can be reinstalled,
# which would revert the block without any command being run. Runs on every
# appblock invocation.
# A shim whose embedded key no longer matches the canonical id for its launch
# name is inert (the pre-fix reverse-DNS bug: shim named `firefox`, keyed on
# `firefox`, while blocked.list held `org.mozilla.firefox`). Regenerate those in
# place so an existing install self-heals on the next invocation instead of
# staying silently unenforced. Cheap: only already-existing shims are inspected.
heal_shims() {
  [ -s "$MANAGED" ] || return 0
  grep -vxF '' "$MANAGED" 2>/dev/null | while IFS= read -r a; do
    [ -n "$a" ] || continue
    [ -f "$SHIMS/$a" ] || continue
    want=$(resolve_desktop_id "$a" 2>/dev/null) || want=
    want=${want:-$a}
    cur=$(sed -n 's/^# appblock-block-key: //p' "$SHIMS/$a" | head -n1)
    [ "$cur" = "$want" ] && continue
    if install_shim "$a" "$want"; then
      echo "  ↻ refreshed shim key for $a (${cur:-none} → $want)"
    fi
  done
}

reconcile() {
  heal_shims

  # FRICTION cooldown: a lift requested via `unblock`/`toggle` is only SCHEDULED
  # — it lands here once its wait elapses. This is the ONLY path that performs a
  # user-requested lift, and there is deliberately no flag that skips the wait.
  if [ -s "$UNBLOCK_AT" ]; then
    now=$(date +%s)
    while IFS='|' read -r id epoch; do
      [ -n "$id" ] && [ -n "$epoch" ] || continue
      [ "$now" -ge "$epoch" ] || continue
      esc=$(printf '%s' "$id" | sed 's/[][\.*^$/]/\\&/g')
      sed -i "/^${esc}$/d" "$STATE"
      sed -i "/^${esc}|/d" "$UNBLOCK_AT"
      # shim + autostart key on the LAUNCH binary name, not the canonical id.
      _bk=$(shim_binary_for_key "$id" || :); _bk=${_bk:-$id}
      unhide_desktop "$id"; restore_autostart "$_bk"; restore_desktop_icons "$id"
      webapp_del "$id"; until_del "$id"
      echo "✅ $id cooldown elapsed — unblocked"
    done < "$UNBLOCK_AT"
    refresh_webguard
  fi

  # Lazy timed-expiry, part 1: the shim lifts a launch the instant its deadline
  # passes — but menu/icons/autostart only get repaired here (on every run), so
  # expire any overdue timed block fully even if it was never launched.
  if [ -s "$UNTIL" ]; then
    now=$(date +%s)
    while IFS='|' read -r id epoch; do
      [ -n "$id" ] && [ -n "$epoch" ] || continue
      [ "$now" -ge "$epoch" ] || continue
      esc=$(printf '%s' "$id" | sed 's/[][\.*^$/]/\\&/g')
      sed -i "/^${esc}$/d" "$STATE"
      sed -i "/^${esc}|/d" "$UNTIL"
      sed -i "/^${esc}|/d" "$UNBLOCK_AT"   # deadline beat any pending lift
      # shim + autostart are keyed on the LAUNCH binary name, not the canonical
      # id — resolve it back through the shim marker (falls back to the id for
      # same-name apps and for shim-less web-apps).
      _bk=$(shim_binary_for_key "$id" || :); _bk=${_bk:-$id}
      unhide_desktop "$id"; restore_autostart "$_bk"; restore_desktop_icons "$id"
      rm -f "$SHIMS/$_bk"
      webapp_del "$id"
      echo "⏳ $id timed block expired — unblocked"
    done < "$UNTIL"
    refresh_webguard
  fi

  grep -vxF '' "$STATE" 2>/dev/null | while IFS= read -r app; do
    [ -n "$app" ] || continue
    if desktop_visible "$app"; then
      hide_desktop "$app" && echo "  ↻ re-hid menu entry for $app (drift repaired)"
    fi
    hide_desktop_icons "$app"   # re-hides an icon recreated while blocked
    if [ -d "$AUTOSTART_DIR" ]; then
      for f in "$AUTOSTART_DIR"/*.desktop; do
        [ -f "$f" ] || break
        ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
        _bn=${ex##*/}
        _alt=$(shim_binary_for_key "$app") || _alt=
        if [ "$_bn" != "$app" ] && { [ -z "$_alt" ] || [ "$_bn" != "$_alt" ]; }; then continue; fi
        grep -q '^Hidden=true' "$f" || { disable_autostart "$_bn"; break; }
      done
    fi
  done
  refresh_webguard
}

ensure_path() {
  snippet='export PATH="$HOME/.local/share/appblock/shims:$PATH"'
  marker='# appblock shims (added by appblock)'
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$rc" ] || continue
    grep -qF "$marker" "$rc" || printf '\n%s\n%s\n' "$marker" "$snippet" >>"$rc"
  done
  # also keep a stable entry point in the shim dir (symlink to the running script)
  src=$(readlink -f "$0" 2>/dev/null || echo "$0")
  cur=$(readlink -f "$SELF" 2>/dev/null || echo "")
  if [ "$src" != "$cur" ]; then
    ln -sf "$src" "$SELF" 2>/dev/null || cp -f "$0" "$SELF"
    chmod +x "$SELF" 2>/dev/null || true
  fi
}

# Wire the shim dir into every launch path: interactive shells (.bashrc/
# .zshrc), the systemd --user environment (~/.config/environment.d, covers
# user services, systemd-run, portal-spawned apps), and the Hyprland/
# compositor environment (hl.env — reaches keybind dispatcher + launcher
# spawned apps in a way hyprctl setenv does not). Idempotent: marker-based.
install_env() {
  ensure_path
  mkdir -p "$HOME/.config/environment.d"
  ed="$HOME/.config/environment.d/appblock.conf"
  printf '# appblock shims (added by appblock)\nPATH="%s:${PATH}"\n' "$SHIMS" >"$ed"

  hypr="$HOME/.config/hypr/hyprland.lua"
  if [ -f "$hypr" ]; then
    hyprmarker='-- appblock shims on PATH (added by appblock)'
    if ! grep -qF -- "$hyprmarker" "$hypr"; then
      printf '\n%s\nhl.env("PATH", "%s:" .. (os.getenv("PATH") or ""))\n' "$hyprmarker" "$SHIMS" >>"$hypr"
    fi
  fi

  # Apply to the live systemd user manager now (no re-login needed for units
  # started after this point). The shell we run in may already have shims on
  # PATH from ensure_path; prepending is harmless either way.
  systemctl --user set-environment PATH="$SHIMS:$PATH" 2>/dev/null \
    && echo "✔ systemd --user environment updated (PATH now includes shims)"
  echo "✔ wired into: ~/.bashrc, ~/.zshrc, ~/.config/environment.d/appblock.conf, hyprland.lua"
  echo "ℹ️  fully effective after next login; until then, units/services started"
  echo "   now inherit PATH from the live manager (already updated)."
}

cmd="$1"; shift 2>/dev/null || { echo "usage: appblock block|unblock|toggle|list <app...>"; exit 2; }

# True if $1 is launch-enforced RIGHT NOW (no block-time caching): the shim
# exists AND either its recorded exec target is alive, or the binary is
# still discoverable live on PATH (shim is stale but a `block`/`shims` run
# would immediately refurbish it). Emits the label via stdout for `list`.
enforcement_label() {
  case "$1" in
    http://*|https://*)
      echo "web-app URL guard (keybind/launcher intercepted)"; return 0 ;;
  esac
  _el_shim=$(shim_for_key "$1") || _el_shim=
  if [ -n "$_el_shim" ]; then
    _el_bin=${_el_shim##*/}          # launch name: exec target / re-resolve name
    t=$(sed -n 's/^exec "\([^"]*\)" .*/\1/p' "$_el_shim")
    if [ -n "$t" ] && [ -x "$t" ]; then
      echo "enforced"
    elif [ -n "$(find_real "$_el_bin")" ]; then
      echo "enforced (shim stale — refresh with 'appblock shims')"
    else
      echo "hidden only — target gone (re-run 'appblock block $_el_bin' to refresh)"
    fi
  elif [ -f "$DESKTOP_DIR/.appblock-disabled.$1.desktop.off" ]; then
    if webguarded "$1"; then
      echo "menu hidden + omarchy-launch-webapp guard (keybind intercepted)"
    else
      echo "hidden only (menu entry hidden; direct launch NOT intercepted)"
    fi
  elif webguarded "$1"; then
    echo "omarchy-launch-webapp guard (keybind intercepted)"
  else
    echo "not launch-enforced"
  fi
  return 0
}

# True if $1 has any discoverable launch surface (desktop entry, autostart
# entry, or resolvable on PATH). Non-PATH apps (Flatpak/web-apps/PWAs) can
# still be blocked at the menu + autostart layer.
surface_found() {
  find_desktop_file "$1" >/dev/null 2>&1 && return 0
  [ -d "$AUTOSTART_DIR" ] || return 1
  for f in "$AUTOSTART_DIR"/*.desktop; do
    [ -f "$f" ] || continue
    ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
    [ "${ex##*/}" = "$1" ] && return 0
  done
  return 1
}

case "$cmd" in
  block|unblock|toggle)
    [ $# -ge 1 ] || { echo "usage: appblock $cmd <app...>"; exit 2; }
    ensure_path
    # Peel off --until <duration> (block deadline) and the friction knobs
    # --after <duration> / --cancel (lift cooldown). They apply to every app/URL
    # named in the same call.
    until_epoch=
    after_secs=
    cancel_pending=
    _args=
    while [ $# -gt 0 ]; do
      case "$1" in
        --until)
          [ $# -ge 2 ] || { echo "  ! --until needs a duration (e.g. 25m, 2h, 1h30m)" >&2; exit 2; }
          until_epoch=$(parse_duration_to_epoch "$2") \
            || { echo "  ! unparseable --until duration '$2'" >&2; exit 2; }
          shift 2 ;;
        --after)
          [ $# -ge 2 ] || { echo "  ! --after needs a duration (e.g. 10m, 1h)" >&2; exit 2; }
          _t=$(parse_duration_to_epoch "$2") \
            || { echo "  ! unparseable --after duration '$2'" >&2; exit 2; }
          after_secs=$(( _t - $(date +%s) ))
          [ "$after_secs" -ge "$UNBLOCK_WAIT_MIN" ] \
            || { echo "  ! --after must be at least ${UNBLOCK_WAIT_MIN}s — that wait IS the feature; to lift a block now, edit $STATE" >&2; exit 2; }
          shift 2 ;;
        --cancel)
          cancel_pending=1; shift ;;
        *) _args="$_args $1"; shift ;;
      esac
    done
    eval "set -- $_args"
    [ $# -ge 1 ] || { echo "usage: appblock $cmd <app...>"; exit 2; }
    if [ "$cmd" = "block" ] && { [ -n "$after_secs" ] || [ -n "$cancel_pending" ]; }; then
      echo "  ! --after/--cancel apply to unblock (and toggle); blocking is immediate" >&2; exit 2
    fi
    [ -n "$after_secs" ] || after_secs=$UNBLOCK_WAIT_DEFAULT
    for app in "$@"; do
      if [ "$app" = "appblock" ]; then
        echo "  ! won't block appblock itself"; continue
      fi
      # A URL is a first-class block target: omarchy web-app keybinds launch
      # `omarchy-launch-webapp <url>` with no .desktop entry involved at all,
      # so there is nothing to shim or hide — the guard shim covers it.
      case "$app" in
        http://*|https://*)
          case "$cmd" in
            block)   is_blocked "$app" || echo "$app" >>"$STATE"
                     webapp_add "$app" "$(normalize_url "$app")"; refresh_webguard
                     hide_desktop_icons "$app"; until_add "$app" "$until_epoch" ;;
            unblock) if [ -n "$cancel_pending" ]; then
                       unblock_del "$app"; echo "🚫 $app stays blocked — pending unblock cancelled"
                     elif is_blocked "$app" || unblock_pending "$app"; then
                       unblock_add "$app" "$after_secs"; unblock_notice "$app"
                     else
                       echo "  ! $app is not blocked"
                     fi
                     continue ;;
            toggle)  if is_blocked "$app"; then
                       if [ -n "$cancel_pending" ]; then
                         unblock_del "$app"; echo "🚫 $app stays blocked — pending unblock cancelled"
                       else
                         unblock_add "$app" "$after_secs"; unblock_notice "$app"
                       fi
                     else
                       echo "$app" >>"$STATE"; webapp_add "$app" "$(normalize_url "$app")"
                       refresh_webguard; hide_desktop_icons "$app"
                       until_add "$app" "$until_epoch"; echo "🚫 $app blocked"
                     fi
                     continue ;;
          esac
          echo "🚫 $app blocked (web-app URL guard — covers this URL and paths under it)"
          continue ;;
      esac
      ok=0
      shim_ok=0
      # Resolve FIRST so the shim can be keyed on the canonical id rather than the
      # raw typed name: for reverse-DNS desktop ids (org.mozilla.firefox) they
      # differ, and a name-keyed shim could never match blocked.list. Both calls
      # only OR into `ok`, so the reorder changes nothing else.
      id=$(resolve_desktop_id "$app") && ok=1
      entry=${id:-$app}
      install_shim "$app" "$entry" && { shim_ok=1; ok=1; }
      if [ "$ok" -ne 1 ]; then
        if [ "$cmd" = "unblock" ] || { [ "$cmd" = "toggle" ] && is_blocked "$app"; }; then
          # No launch surface left (app uninstalled?) — the blocklist still gets
          # cleared at lift time, and the cooldown still applies.
          if [ -n "$cancel_pending" ]; then
            unblock_del "$app"; echo "🚫 $app stays blocked — pending unblock cancelled"
          elif is_blocked "$app" || unblock_pending "$app"; then
            unblock_add "$app" "$after_secs"; unblock_notice "$app"
          else
            echo "  ! $app is not blocked"
          fi
        else
          echo "  ! no launch surface found for '$app' (not on PATH, no desktop/autostart entry) — skipping"
        fi
        continue
      fi
      entry=${id:-$app}   # canonical blocklist name = resolved desktop id
      wurl=$(webapp_url "$entry" 2>/dev/null || true)   # web-app? record its URL
      case "$cmd" in
        block)   is_blocked "$entry" || echo "$entry" >>"$STATE";  hide_desktop "$id"; disable_autostart "$app"
                 webapp_add "$entry" "$(normalize_url "${wurl:-}")"; hide_desktop_icons "$entry"; until_add "$entry" "$until_epoch"
                 echo "🚫 $entry blocked" ;;
        unblock) if [ -n "$cancel_pending" ]; then
                   unblock_del "$entry"; echo "🚫 $entry stays blocked — pending unblock cancelled"
                 elif is_blocked "$entry" || unblock_pending "$entry"; then
                   unblock_add "$entry" "$after_secs"; unblock_notice "$entry"
                 else
                   echo "  ! $entry is not blocked"
                 fi ;;
        toggle)  if is_blocked "$entry"; then
                   if [ -n "$cancel_pending" ]; then
                     unblock_del "$entry"; echo "🚫 $entry stays blocked — pending unblock cancelled"
                   else
                     unblock_add "$entry" "$after_secs"; unblock_notice "$entry"
                   fi
                 else
                   echo "$entry" >>"$STATE"; hide_desktop "$id"; disable_autostart "$app"
                   webapp_add "$entry" "$(normalize_url "${wurl:-}")"; hide_desktop_icons "$entry"
                   until_add "$entry" "$until_epoch"; echo "🚫 $entry blocked"
                 fi ;;
      esac
      if [ "$cmd" = "block" ] && [ "$shim_ok" -ne 1 ]; then
        if [ -n "$wurl" ]; then
          echo "  (menu hiding + web-app URL guard — no PATH binary to shim)"
        else
          echo "  (menu/autostart-level only — no PATH binary found to shim)"
        fi
      fi
    done
    reconcile
    echo "ℹ️  open shells may have the old path cached — run 'hash -r' in them (new terminals pick it up instantly)"
    ;;
  list)
    reconcile
    echo "Blocked apps:"
    n=$(grep -c . "$STATE" 2>/dev/null || :); n=${n:-0}
    [ "$n" -eq 0 ] && echo "  (none)"
    grep -vxF '' "$STATE" 2>/dev/null | while IFS= read -r app; do
      [ -n "$app" ] || continue
      _u=$(until_remaining "$app"); _p=$(unblock_remaining "$app")
      echo "  🚫 $app — $(enforcement_label "$app")${_u:+" ($_u)"}${_p:+" (unblocks in $_p)"}"
    done
    echo "Managed apps (add more: appblock block <app>):"
    grep -vxF '' "$MANAGED" 2>/dev/null | sed 's/^/  - /' || echo "  (none)"
    ;;
  shims) while read -r a; do
           [ -n "$a" ] || continue
           install_shim "$a" || echo "  ! could not (re)install shim for '$a' (binary not on PATH?)" >&2
         done <"$MANAGED"; refresh_webguard; echo "shims refreshed" ;;
  install) install_env ;;
  *) echo "usage: appblock block|unblock|toggle|list|shims|install"; exit 2 ;;
esac