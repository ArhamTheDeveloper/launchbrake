#!/bin/sh
# appblock — block/unblock distracting apps (works for terminal AND launcher)
# Usage:
#   appblock block <app> [app...]    add apps to the blocklist
#   appblock unblock <app> [app...]  remove apps from the blocklist
#   appblock toggle <app> [app...]   flip blocked state for apps
#   appblock list                    show managed + blocked apps
#   appblock shims                   (re)install PATH shims for managed apps

set -eu

BASE="$HOME/.local/share/appblock"
SHIMS="$BASE/shims"
STATE="$BASE/blocked.list"
MANAGED="$BASE/managed.list"
DESKTOP_DIR="$HOME/.local/share/applications"
AUTOSTART_DIR="$HOME/.config/autostart"
BACKUP_DIR="$BASE/autostart-backup"
SELF="$SHIMS/appblock"

mkdir -p "$SHIMS" "$DESKTOP_DIR"
touch "$STATE" "$MANAGED"

is_blocked() { grep -qxF "$1" "$STATE"; }

# Find the real binary for NAME, searching PATH while skipping the shim dir.
find_real() {
  name=$1; found=
  oIFS=$IFS; IFS=:; set -f; set -- $PATH; IFS=$oIFS; set +f
  for d in "$@"; do
    [ "$d" = "$SHIMS" ] && continue
    [ -n "$d" ] && [ -x "$d/$name" ] && { found="$d/$name"; break; }
  done
  echo "$found"
}

# Create/refresh the PATH shim for an app so 'app <args>' resolves to it.
install_shim() {
  name="$1"
  # STRUCTURAL GUARD (not just convention): generated shims live under
  # $SHIMS. If one is ever (accidentally, via refactor) made to re-invoke
  # appblock, refuse rather than risk touching state/cleanup from launch
  # context — e.g. a transient PATH gap must never delete a shim at run time.
  # Compare the SYMLINK-RESOLVED path: the legit `appblock` command reaches
  # us via the shims/appblock symlink, so "$0" alone would false-positive.
  self0=$(readlink -f "$0" 2>/dev/null || echo "$0")
  case "$self0" in
    "$SHIMS"/*) echo "  ! appblock may not run from within a shim (launch-time is never a management moment)" >&2; return 1 ;;
  esac
  [ "$name" = "appblock" ] && return 1
  real=$(find_real "$name")
  if [ -z "$real" ] && [ -f "$SHIMS/$name" ]; then
    # PATH no longer resolves the app directly (e.g. binary moved after an
    # upgrade); fall back to the path the existing shim was created with.
    real=$(sed -n 's/^exec "\([^"]*\)" .*/\1/p' "$SHIMS/$name")
  fi
  [ -n "$real" ] && [ -x "$real" ] || {
    # Nothing valid to exec — don't leave a shim that would look like a
    # broken app later. Removing it means 'app' → honest "command not found".
    # NOTE: this runs ONLY during explicit CLI invocations (block/unblock/
    # toggle/shims); generated shims never call install_shim, so a transient
    # PATH gap during a package upgrade can never delete a shim at launch time.
    rm -f "$SHIMS/$name"
    echo "  ! '$name' not found on PATH, skipping" >&2; return 1
  }
  grep -qxF "$name" "$MANAGED" || echo "$name" >>"$MANAGED"
  cat >"$SHIMS/$name.tmp" <<EOF
#!/bin/sh
# generated by appblock — do not edit (refresh with: appblock shims)
if grep -qxF '$name' "$STATE" 2>/dev/null; then
  echo "🚫 $name is blocked (unblock with: appblock unblock $name)" >&2
  exit 1
fi
exec "$real" "\$@"
EOF
  mv -f "$SHIMS/$name.tmp" "$SHIMS/$name"
  chmod +x "$SHIMS/$name"
}

# Hide the app's .desktop entry from app menus via a NoDisplay override.
# By the Base Directory Spec, $XDG_DATA_HOME (~/.local/share) is always
# searched before $XDG_DATA_DIRS, so an override here wins over /usr/share
# AND flatpak exports on every spec-compliant DE (GLib GDesktopAppInfo walks
# them in this order). Cache note: GNOME Shell caches its app grid and may
# need update-desktop-database / logout to notice the change immediately.
hide_desktop() {
  for d in /usr/share/applications /usr/local/share/applications \
           /var/lib/flatpak/exports/share/applications \
           "$HOME/.local/share/flatpak/exports/share/applications"; do
    [ -f "$d/$1.desktop" ] && break
  done || return 0
  printf '[Desktop Entry]\nType=Application\nName=%s\nNoDisplay=true\nExec=%s\n' "$1" "$1" \
    >"$DESKTOP_DIR/$1.desktop"
}

unhide_desktop() { rm -f "$DESKTOP_DIR/$1.desktop"; }

# XDG autostart entries (tray/background apps) often use absolute Exec paths
# and bypass PATH entirely. Disable on block, restore on unblock.
disable_autostart() {
  [ -d "$AUTOSTART_DIR" ] || return 0
  for f in "$AUTOSTART_DIR"/*.desktop; do
    [ -f "$f" ] || return 0
    ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
    [ "${ex##*/}" = "$1" ] || continue
    mkdir -p "$BACKUP_DIR"
    cp -n "$f" "$BACKUP_DIR/"
    grep -q '^Hidden=' "$f" && sed -i 's/^Hidden=.*/Hidden=true/' "$f" \
      || printf 'Hidden=true\n' >>"$f"
    echo "  → disabled autostart entry: $(basename "$f")"
  done
}

# Re-enable an autostart entry at unblock, MERGING rather than restoring:
# only ever touch the Hidden key we may have patched, and leave every other
# line (Exec, flags, etc.) exactly as the live file has it — an app update
# that legitimately changed Exec= between block and unblock must NOT be
# reverted by us. The backup exists solely to recover the original Hidden value.
restore_autostart() {
  [ -d "$AUTOSTART_DIR" ] || return 0
  for f in "$AUTOSTART_DIR"/*.desktop; do
    [ -f "$f" ] || continue
    ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
    [ "${ex##*/}" = "$1" ] || continue
    orig=
    b="$BACKUP_DIR/$(basename "$f")"
    [ -f "$b" ] && orig=$(sed -n 's/^Hidden=//p' "$b" | head -n1)
    # drop our patch, then re-apply the file's original Hidden value if any
    sed -i '/^Hidden=/d' "$f"
    [ -n "$orig" ] && printf 'Hidden=%s\n' "$orig" >>"$f"
    rm -f "$b"
    echo "  → re-enabled autostart entry: $(basename "$f")"
  done
}

# Re-apply hiding for everything still in the blocklist. Repairs drift:
# an app update can silently overwrite our autostart Hidden=true (some apps
# re-add their own autostart entry), which would revert the block without
# any command being run. This runs on every appblock invocation.
reconcile() {
  grep -vxF '' "$STATE" 2>/dev/null | while IFS= read -r app; do
    [ -n "$app" ] || continue
    if [ ! -f "$DESKTOP_DIR/$app.desktop" ]; then
      hide_desktop "$app" && [ -f "$DESKTOP_DIR/$app.desktop" ] \
        && echo "  ↻ re-hid menu entry for $app (drift repaired)"
    fi
    if [ -d "$AUTOSTART_DIR" ]; then
      for f in "$AUTOSTART_DIR"/*.desktop; do
        [ -f "$f" ] || break
        ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
        [ "${ex##*/}" = "$app" ] || continue
        grep -q '^Hidden=true' "$f" || { disable_autostart "$app"; break; }
      done
    fi
  done
}

ensure_path() {
  snippet='export PATH="$HOME/.local/share/appblock/shims:$PATH"'
  marker='# appblock shims (added by appblock)'
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$rc" ] || continue
    grep -qF "$marker" "$rc" || printf '\n%s\n%s\n' "$marker" "$snippet" >>"$rc"
  done
  # also keep a stable entry point in the shim dir (symlink to the running script)
  src=$(readlink -f "$0" 2>/dev/null || echo "$0")
  cur=$(readlink -f "$SELF" 2>/dev/null || echo "")
  if [ "$src" != "$cur" ]; then
    ln -sf "$src" "$SELF" 2>/dev/null || cp -f "$0" "$SELF"
    chmod +x "$SELF" 2>/dev/null || true
  fi
}

# Wire the shim dir into every launch path: interactive shells (.bashrc/
# .zshrc), the systemd --user environment (~/.config/environment.d, covers
# user services, systemd-run, portal-spawned apps), and the Hyprland/
# compositor environment (hl.env — reaches keybind dispatcher + launcher
# spawned apps in a way hyprctl setenv does not). Idempotent: marker-based.
install_env() {
  ensure_path
  mkdir -p "$HOME/.config/environment.d"
  ed="$HOME/.config/environment.d/appblock.conf"
  printf '# appblock shims (added by appblock)\nPATH="%s:${PATH}"\n' "$SHIMS" >"$ed"

  hypr="$HOME/.config/hypr/hyprland.lua"
  if [ -f "$hypr" ]; then
    hyprmarker='-- appblock shims on PATH (added by appblock)'
    if ! grep -qF -- "$hyprmarker" "$hypr"; then
      printf '\n%s\nhl.env("PATH", "%s:" .. (os.getenv("PATH") or ""))\n' "$hyprmarker" "$SHIMS" >>"$hypr"
    fi
  fi

  # Apply to the live systemd user manager now (no re-login needed for units
  # started after this point). The shell we run in may already have shims on
  # PATH from ensure_path; prepending is harmless either way.
  systemctl --user set-environment PATH="$SHIMS:$PATH" 2>/dev/null \
    && echo "✔ systemd --user environment updated (PATH now includes shims)"
  echo "✔ wired into: ~/.bashrc, ~/.zshrc, ~/.config/environment.d/appblock.conf, hyprland.lua"
  echo "ℹ️  fully effective after next login; until then, units/services started"
  echo "   now inherit PATH from the live manager (already updated)."
}

cmd="$1"; shift 2>/dev/null || { echo "usage: appblock block|unblock|toggle|list <app...>"; exit 2; }

# True if $1 is launch-enforced RIGHT NOW (no block-time caching): the shim
# exists AND either its recorded exec target is alive, or the binary is
# still discoverable live on PATH (shim is stale but a `block`/`shims` run
# would immediately refurbish it). Emits the label via stdout for `list`.
enforcement_label() {
  [ -f "$SHIMS/$1" ] || { echo "not launch-enforced"; return 0; }
  t=$(sed -n 's/^exec "\([^"]*\)" .*/\1/p' "$SHIMS/$1")
  if [ -n "$t" ] && [ -x "$t" ]; then
    echo "enforced"
  elif [ -n "$(find_real "$1")" ]; then
    echo "enforced (shim stale — refresh with 'appblock shims')"
  else
    echo "hidden only — target gone (re-run 'appblock block $1' to refresh)"
  fi
  return 0
}

# True if $1 has any discoverable launch surface (desktop entry, autostart
# entry, or resolvable on PATH). Non-PATH apps (Flatpak/tray/bundled) can
# still be blocked at the menu + autostart layer.
surface_found() {
  local d f ex
  for d in /usr/share/applications /usr/local/share/applications \
           /var/lib/flatpak/exports/share/applications \
           "$HOME/.local/share/flatpak/exports/share/applications"; do
    [ -f "$d/$1.desktop" ] && return 0
  done
  [ -d "$AUTOSTART_DIR" ] || return 1
  for f in "$AUTOSTART_DIR"/*.desktop; do
    [ -f "$f" ] || continue
    ex=$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)
    [ "${ex##*/}" = "$1" ] && return 0
  done
  return 1
}

case "$cmd" in
  block|unblock|toggle)
    [ $# -ge 1 ] || { echo "usage: appblock $cmd <app...>"; exit 2; }
    ensure_path
    for app in "$@"; do
      if [ "$app" = "appblock" ]; then
        echo "  ! won't block appblock itself"; continue
      fi
      ok=0
      install_shim "$app" && ok=1
      surface_found "$app" && ok=1
      if [ "$ok" -ne 1 ]; then
        if [ "$cmd" = "unblock" ]; then
          # No launch surface left (app uninstalled?) — unblocking must still
          # clear the blocklist; only hide-desktop finds nothing to undo.
          sed -i "/^$(printf '%s' "$app" | sed 's/[][\.*^$/]/\\&/g')$/d" "$STATE"
          unhide_desktop "$app"; restore_autostart "$app"
          echo "✅ $app unblocked (no launch surface remains)"
        else
          echo "  ! no launch surface found for '$app' (not on PATH, no desktop/autostart entry) — skipping"
        fi
        continue
      fi
      case "$cmd" in
        block)   is_blocked "$app" || echo "$app" >>"$STATE";  hide_desktop "$app"; disable_autostart "$app" ;;
        unblock) sed -i "/^$(printf '%s' "$app" | sed 's/[][\.*^$/]/\\&/g')$/d" "$STATE"; unhide_desktop "$app"; restore_autostart "$app" ;;
        toggle)  if is_blocked "$app"; then sed -i "/^$(printf '%s' "$app" | sed 's/[][\.*^$/]/\\&/g')$/d" "$STATE"; unhide_desktop "$app"; restore_autostart "$app"; echo "✅ $app unblocked"; else echo "$app" >>"$STATE"; hide_desktop "$app"; disable_autostart "$app"; echo "🚫 $app blocked"; fi; continue ;;
      esac
      is_blocked "$app" && echo "🚫 $app blocked" || echo "✅ $app unblocked"
    done
    reconcile
    echo "ℹ️  open shells may have the old path cached — run 'hash -r' in them (new terminals pick it up instantly)"
    ;;
  list)
    reconcile
    echo "Blocked apps:"
    n=$(grep -c . "$STATE" 2>/dev/null || echo 0)
    [ "$n" -eq 0 ] && echo "  (none)"
    grep -vxF '' "$STATE" 2>/dev/null | while IFS= read -r app; do
      [ -n "$app" ] || continue
      echo "  🚫 $app — $(enforcement_label "$app")"
    done
    echo "Managed apps (add more: appblock block <app>):"
    grep -vxF '' "$MANAGED" 2>/dev/null | sed 's/^/  - /' || echo "  (none)"
    ;;
  shims) while read -r a; do [ -n "$a" ] && install_shim "$a" || true; done <"$MANAGED"; echo "shims refreshed" ;;
  install) install_env ;;
  *) echo "usage: appblock block|unblock|toggle|list|shims|install"; exit 2 ;;
esac